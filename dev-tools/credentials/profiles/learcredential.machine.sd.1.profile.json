{
  "credential_configuration_id": "learcredential.machine.sd.1",
  "description": "Verifiable Credential for machines",
  "credential_metadata": {
    "display": [
      {
        "name": "LEAR Credential Machine",
        "locale": "en",
        "description": "Verifiable Credential for machines"
      },
      {
        "name": "Credencial LEAR Máquina",
        "locale": "es",
        "description": "Credencial Verificable para máquinas"
      },
      {
        "name": "Credencial LEAR Màquina",
        "locale": "ca",
        "description": "Credencial Verificable per a màquines"
      }
    ],
    "claims": [
      { "path": ["mandate", "mandator", "commonName"],             "display": [{ "name": "Common Name", "locale": "en" }, { "name": "Nombre Común", "locale": "es" }, { "name": "Nom Comú", "locale": "ca" }] },
      { "path": ["mandate", "mandator", "email"],                  "display": [{ "name": "Email", "locale": "en" }, { "name": "Correo Electrónico", "locale": "es" }, { "name": "Correu Electrònic", "locale": "ca" }] },
      { "path": ["mandate", "mandator", "serialNumber"],           "display": [{ "name": "Serial Number", "locale": "en" }, { "name": "Número de Serie", "locale": "es" }, { "name": "Número de Sèrie", "locale": "ca" }] },
      { "path": ["mandate", "mandator", "organization"],           "display": [{ "name": "Organization", "locale": "en" }, { "name": "Organización", "locale": "es" }, { "name": "Organització", "locale": "ca" }] },
      { "path": ["mandate", "mandator", "organizationIdentifier"], "display": [{ "name": "Organization ID", "locale": "en" }, { "name": "ID de Organización", "locale": "es" }, { "name": "ID d'Organització", "locale": "ca" }] },
      { "path": ["mandate", "mandator", "country"],                "display": [{ "name": "Country", "locale": "en" }, { "name": "País", "locale": "es" }, { "name": "País", "locale": "ca" }] },
      { "path": ["mandate", "mandatee", "id"],                     "display": [{ "name": "ID", "locale": "en" }, { "name": "ID", "locale": "es" }, { "name": "ID", "locale": "ca" }] },
      { "path": ["mandate", "mandatee", "serviceId"],              "display": [{ "name": "Service ID", "locale": "en" }, { "name": "ID de Servicio", "locale": "es" }, { "name": "ID de Servei", "locale": "ca" }] },
      { "path": ["mandate", "mandatee", "domain"],                 "display": [{ "name": "Domain", "locale": "en" }, { "name": "Dominio", "locale": "es" }, { "name": "Domini", "locale": "ca" }] },
      { "path": ["mandate", "mandatee", "ipAddress"],              "display": [{ "name": "IP Address", "locale": "en" }, { "name": "Dirección IP", "locale": "es" }, { "name": "Adreça IP", "locale": "ca" }] },
      { "path": ["mandate", "power"],                              "display": [{ "name": "Powers", "locale": "en" }, { "name": "Poderes", "locale": "es" }, { "name": "Poders", "locale": "ca" }] }
    ]
  },
  "subject_extraction": {
    "strategy": "field",
    "fields": ["mandatee.domain"],
    "separator": null
  },
  "organization_extraction": {
    "strategy": "field",
    "field": "mandator.organizationIdentifier"
  },
  "policy_extraction": {
    "powers_path": "power",
    "mandator_path": "mandator",
    "org_id_field": "organizationIdentifier"
  },
  "validation": {
    "schema_required": true,
    "valid_from_path": "nbf",
    "valid_until_path": "exp",
    "issuer_id_path": "iss",
    "mandator_org_id_path": "mandate.mandator.organizationIdentifier",
    "revocation": {
      "status_id_path": "status.status_list.uri",
      "status_type_path": null,
      "status_purpose_path": null,
      "status_list_credential_path": "status.status_list.uri",
      "status_list_index_path": "status.status_list.idx"
    }
  },
  "grant_eligibility": ["client_credentials", "authorization_code"],
  "token_claims_mapping": {
    "subject_paths": ["mandate.mandatee.ipAddress", "mandate.mandatee.domain"],
    "access_token": {},
    "id_token_embed": {
      "mandatee": "mandate.mandatee",
      "mandator": "mandate.mandator",
      "power": "mandate.power"
    },
    "access_token_embed": {
      "mandatee": "mandate.mandatee",
      "mandator": "mandate.mandator",
      "power": "mandate.power"
    },
    "scope": "machine learcredential"
  }
}
