{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doctor ID V1 (dc+sd-jwt)",

  "credential_configuration_id": "doctorid.sd.1",
  "credential_format": "dc+sd-jwt",
  "scope": "doctor_id_sd_jwt",
  "credential_definition": {
    "context": [
      "https://www.w3.org/ns/credentials/v2",
      "https://credentials.eudistack.eu/.well-known/credentials/doctor_id/sd/v1"
    ],
    "type": ["VerifiableCredential", "doctorid.sd.1"]
  },
  "cryptographic_binding_methods_supported": ["jwk"],
  "credential_signing_alg_values_supported": ["ES256"],
  "proof_types_supported": {
    "jwt": { "proof_signing_alg_values_supported": ["ES256"] }
  },
  "credential_metadata": {
    "display": [
      {
        "name": "Doctor ID",
        "locale": "en",
        "description": "Verifiable Credential for licensed medical doctors"
      },
      {
        "name": "Identificación Médica",
        "locale": "es",
        "description": "Credencial Verificable para médicos colegiados"
      }
    ],
    "claims": [
      { "path": ["firstName"],          "display": [{ "name": "First Name", "locale": "en" }, { "name": "Nombre", "locale": "es" }] },
      { "path": ["lastName"],           "display": [{ "name": "Last Name", "locale": "en" }, { "name": "Apellidos", "locale": "es" }] },
      { "path": ["registrationNumber"], "display": [{ "name": "Registration Number", "locale": "en" }, { "name": "Número de Colegiado", "locale": "es" }] },
      { "path": ["nationalId"],         "display": [{ "name": "National ID", "locale": "en" }, { "name": "DNI", "locale": "es" }] },
      { "path": ["provincialBoard"],    "display": [{ "name": "Provincial Board", "locale": "en" }, { "name": "Colegio Provincial", "locale": "es" }] },
      { "path": ["specialty"],          "display": [{ "name": "Specialty", "locale": "en" }, { "name": "Especialidad", "locale": "es" }] },
      { "path": ["email"],              "display": [{ "name": "Email", "locale": "en" }, { "name": "Correo Electrónico", "locale": "es" }] },
      { "path": ["country"],            "display": [{ "name": "Country", "locale": "en" }, { "name": "País", "locale": "es" }] }
    ],
    "summary_claims": [["firstName"], ["lastName"], ["email"]]
  },
  "validity_days": 365,
  "issuer_type": "DETAILED",
  "cnf_required": true,
  "credential_subject_strategy": "direct",
  "sd_jwt": {
    "vct": "urn:es.cgcom:doctorid:1",
    "vct_integrity": true,
    "sd_alg": "sha-256",
    "sd_claims": ["firstName", "lastName", "registrationNumber", "nationalId", "provincialBoard", "specialty", "email", "country"]
  },
  "status": {
    "type": "TokenStatusList",
    "purpose": "revocation"
  },

  "type": "object",
  "required": ["firstName", "lastName", "registrationNumber", "nationalId", "provincialBoard", "specialty", "email", "country"],
  "additionalProperties": true,
  "properties": {
    "firstName":          { "type": "string" },
    "lastName":           { "type": "string" },
    "registrationNumber": { "type": "string" },
    "nationalId":         { "type": "string" },
    "provincialBoard":    { "type": "string" },
    "specialty":          { "type": "string" },
    "email":              { "type": "string", "format": "email" },
    "country":            { "type": "string" }
  }
}