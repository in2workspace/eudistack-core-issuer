{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doctor ID V1 (dc+sd-jwt)",

  "credential_configuration_id": "doctorid.sd.1",
  "credential_format": "dc+sd-jwt",
  "scope": "doctor_id_sd_jwt",
  "credential_definition": {
    "context": [
      "https://www.w3.org/ns/credentials/v2",
      "https://credentials.eudistack.eu/.well-known/credentials/doctor_id/sd/v1"
    ],
    "type": ["VerifiableCredential", "doctorid.sd.1"]
  },
  "cryptographic_binding_methods_supported": ["jwk"],
  "credential_signing_alg_values_supported": ["ES256"],
  "proof_types_supported": {
    "jwt": { "proof_signing_alg_values_supported": ["ES256"] }
  },
  "credential_metadata": {
    "display": [
      {
        "name": "Doctor ID",
        "locale": "en",
        "description": "Verifiable Credential for licensed medical doctors"
      },
      {
        "name": "Identificación Médica",
        "locale": "es",
        "description": "Credencial Verificable para médicos colegiados"
      }
    ],
    "claims": [
      { "path": ["givenName"],                      "display": [{ "name": "Given Name", "locale": "en" }, { "name": "Nombre", "locale": "es" }] },
      { "path": ["familyName"],                     "display": [{ "name": "Family Name", "locale": "en" }, { "name": "Apellidos", "locale": "es" }] },
      { "path": ["personal_administrative_number"], "display": [{ "name": "Registration Number", "locale": "en" }, { "name": "Número de Colegiado", "locale": "es" }] },
      { "path": ["medical_board"],                  "display": [{ "name": "Medical Board", "locale": "en" }, { "name": "Colegio de Médicos", "locale": "es" }] },
      { "path": ["medical_speciality"],             "display": [{ "name": "Medical Speciality", "locale": "en" }, { "name": "Especialidad", "locale": "es" }] },
      { "path": ["legally_entitled"],               "display": [{ "name": "Legally Entitled to Practise", "locale": "en" }, { "name": "Habilitado para Ejercer", "locale": "es" }] }
    ]
  },
  "validity_days": 36500,
  "issuer_type": "DETAILED",
  "cnf_required": true,
  "credential_subject_strategy": "direct",
  "sd_jwt": {
    "vct": "urn:es.cgcom:doctorid:1",
    "vct_integrity": true,
    "sd_alg": "sha-256",
    "sd_claims": ["givenName", "familyName", "personal_administrative_number", "medical_board", "medical_speciality", "legally_entitled"]
  },
  "status": {
    "type": "TokenStatusList",
    "purpose": "revocation"
  },

  "type": "object",
  "required": ["givenName", "familyName", "personal_administrative_number", "medical_speciality"],
  "additionalProperties": true,
  "properties": {
    "givenName": {
      "type": "string",
      "description": "Current first name(s), including middle name(s) where applicable, of the doctor."
    },
    "familyName": {
      "type": "string",
      "description": "Current last name(s) or surname(s) of the doctor."
    },
    "personal_administrative_number": {
      "type": "string",
      "pattern": "^[0-9]{9}$",
      "description": "Registration number of the physician in the professional body."
    },
    "medical_board": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Regional professional bodies of physicians where the doctor is registered."
    },
    "medical_speciality": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Allergology",
          "Clinical Analysis",
          "Pathological Anatomy",
          "Anesthesiology and Reanimation",
          "Angiology and Vascular Surgery",
          "Digestive System",
          "Clinical Biochemistry",
          "Cardiology",
          "Cardiovascular Surgery",
          "General and Digestive Surgery",
          "Oral and Maxillofacial Surgery",
          "Orthopedic Surgery and Traumatology",
          "Pediatric Surgery",
          "Plastic, Aesthetic, and Reconstructive Surgery",
          "Thoracic Surgery",
          "Medical-Surgical Dermatology and Venereology",
          "Endocrinology and Nutrition",
          "Stomatology",
          "Clinical Pharmacology",
          "Geriatrics",
          "Medical Hydrology",
          "Hematology and Hemotherapy",
          "Immunology",
          "Occupational Medicine",
          "Family and Community Medicine",
          "Physical Education and Sports Medicine",
          "Forensic Medicine",
          "Physical Medicine and Rehabilitation",
          "Intensive Medicine",
          "Internal Medicine",
          "Nuclear Medicine",
          "Preventive Medicine and Public Health",
          "Microbiology and Parasitology",
          "Nephrology",
          "Pulmonology",
          "Neurosurgery",
          "Clinical Neurophysiology",
          "Neurology",
          "Obstetrics and Gynecology",
          "Ophthalmology",
          "Medical Oncology",
          "Radiation Oncology",
          "Otorhinolaryngology",
          "Pediatrics and its Specific Areas",
          "Psychiatry",
          "Radiology",
          "Rheumatology",
          "Urology",
          "General Medicine",
          "Child and Adolescent Psychiatry",
          "Certified General Physician"
        ]
      },
      "description": "Clinical specialities of the doctor."
    },
    "legally_entitled": {
      "type": "boolean",
      "description": "Whether the doctor is qualified to practise medicine, with no record of sanction or disqualification."
    }
  }
}
