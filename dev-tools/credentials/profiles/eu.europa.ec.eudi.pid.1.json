{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EUDI PID V1 (dc+sd-jwt)",

  "credential_configuration_id": "eu.europa.ec.eudi.pid.1",
  "credential_format": "dc+sd-jwt",
  "scope": "eu_europa_ec_eudi_pid_1",
  "credential_definition": {
    "context": [
      "https://www.w3.org/ns/credentials/v2",
      "https://credentials.eudistack.eu/.well-known/credentials/eudi_pid/sd/v1"
    ],
    "type": ["VerifiableCredential", "eu.europa.ec.eudi.pid.1"]
  },
  "cryptographic_binding_methods_supported": ["jwk"],
  "credential_signing_alg_values_supported": ["ES256"],
  "proof_types_supported": {
    "jwt": { "proof_signing_alg_values_supported": ["ES256"] }
  },
  "credential_metadata": {
    "display": [
      {
        "name": "EUDI PID",
        "locale": "en",
        "description": "EU Digital Identity Wallet — Person Identification Data"
      },
      {
        "name": "PID EUDI",
        "locale": "es",
        "description": "Cartera de Identidad Digital Europea — Datos de Identificación Personal"
      }
    ],
    "claims": [
      { "path": ["given_name"],                       "display": [{ "name": "Given Name", "locale": "en" }, { "name": "Nombre", "locale": "es" }] },
      { "path": ["family_name"],                       "display": [{ "name": "Family Name", "locale": "en" }, { "name": "Apellidos", "locale": "es" }] },
      { "path": ["birth_date"],                        "display": [{ "name": "Date of Birth", "locale": "en" }, { "name": "Fecha de Nacimiento", "locale": "es" }] },
      { "path": ["birth_place"],                        "display": [{ "name": "Place of Birth", "locale": "en" }, { "name": "Lugar de Nacimiento", "locale": "es" }] },
      { "path": ["nationality"],                        "display": [{ "name": "Nationality", "locale": "en" }, { "name": "Nacionalidad", "locale": "es" }] },
      { "path": ["issuance_date"],                     "display": [{ "name": "Issuance Date", "locale": "en" }, { "name": "Fecha de Emisión", "locale": "es" }] },
      { "path": ["expiry_date"],                        "display": [{ "name": "Expiry Date", "locale": "en" }, { "name": "Fecha de Caducidad", "locale": "es" }] },
      { "path": ["issuing_authority"],                 "display": [{ "name": "Issuing Authority", "locale": "en" }, { "name": "Autoridad Emisora", "locale": "es" }] },
      { "path": ["issuing_country"],                   "display": [{ "name": "Issuing Country", "locale": "en" }, { "name": "País Emisor", "locale": "es" }] },
      { "path": ["document_number"],                   "display": [{ "name": "Document Number", "locale": "en" }, { "name": "Número de Documento", "locale": "es" }] }
    ],
    "summary_claims": [["given_name"], ["family_name"], ["birth_date"]]
  },
  "validity_days": 365,
  "issuer_type": "DETAILED",
  "cnf_required": true,
  "credential_subject_strategy": "direct",
  "sd_jwt": {
    "vct": "eu.europa.ec.eudi.pid.1",
    "vct_integrity": true,
    "sd_alg": "sha-256",
    "sd_claims": [
      "given_name", "family_name", "birth_date", "birth_place", "nationality",
      "issuance_date", "expiry_date", "issuing_authority", "issuing_country", "document_number"
    ]
  },
  "status": {
    "type": "TokenStatusList",
    "purpose": "revocation"
  },

  "type": "object",
  "required": [
    "given_name", "family_name", "birth_date", "birth_place", "nationality",
    "issuance_date", "expiry_date", "issuing_authority", "issuing_country"
  ],
  "additionalProperties": true,
  "properties": {
    "given_name":         { "type": "string" },
    "family_name":        { "type": "string" },
    "birth_date":         { "type": "string", "format": "date" },
    "birth_place":        { "type": "string" },
    "nationality":        { "type": "string" },
    "issuance_date":      { "type": "string", "format": "date" },
    "expiry_date":        { "type": "string", "format": "date" },
    "issuing_authority":  { "type": "string" },
    "issuing_country":    { "type": "string" },
    "document_number":    { "type": ["string", "null"] }
  }
}
