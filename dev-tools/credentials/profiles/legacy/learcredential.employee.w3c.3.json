{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEAR Credential Employee V3 — DOME (jwt_vc_json, wrapper vc:{})",

  "credential_configuration_id": "learcredential.employee.w3c.3",
  "credential_format": "jwt_vc_json",
  "scope": "lear_credential_employee",
  "credential_definition": {
    "context": [
      "https://www.w3.org/ns/credentials/v2",
      "https://credentials.eudistack.eu/.well-known/credentials/lear_credential_employee/w3c/v3"
    ],
    "type": ["VerifiableCredential", "LEARCredentialEmployee"]
  },
  "cryptographic_binding_methods_supported": ["did:key"],
  "credential_signing_alg_values_supported": ["ES256"],
  "proof_types_supported": {
    "jwt": { "proof_signing_alg_values_supported": ["ES256"] }
  },
  "validity_days": 365,
  "issuer_type": "DETAILED",
  "cnf_required": true,

  "type": "object",
  "required": ["@context", "type", "issuer", "credentialSubject"],
  "additionalProperties": true,
  "vc": {
    "@context": { "type": "array", "items": { "type": "string" } },
    "id": { "type": "string" },
    "type": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "LEARCredentialEmployee" }
    },
    "description": { "type": "string" },
    "issuer": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id":                     { "type": "string" },
        "organizationIdentifier": { "type": "string" },
        "organization":           { "type": "string" },
        "country":                { "type": "string" },
        "commonName":             { "type": "string" },
        "serialNumber":           { "type": "string" }
      }
    },
    "credentialSubject": {
      "type": "object",
      "required": ["mandate"],
      "additionalProperties": true,
      "properties": {
        "mandate": {
          "type": "object",
          "required": ["mandatee", "mandator", "power"],
          "additionalProperties": true,
          "properties": {
            "mandatee": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "id":         { "type": "string" },
                "employeeId": { "type": "string" },
                "email":      { "type": "string" },
                "firstName":  { "type": "string" },
                "lastName":   { "type": "string" }
              }
            },
            "mandator": {
              "type": "object",
              "required": ["organizationIdentifier"],
              "additionalProperties": true,
              "properties": {
                "id":                     { "type": "string" },
                "commonName":             { "type": "string" },
                "country":                { "type": "string" },
                "email":                  { "type": "string" },
                "organization":           { "type": "string" },
                "organizationIdentifier": { "type": "string" },
                "serialNumber":           { "type": "string" }
              }
            },
            "power": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "action":   {},
                  "domain":   { "type": "string" },
                  "function": { "type": "string" },
                  "type":     { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "credentialStatus": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id":                   { "type": "string" },
        "type":                 { "type": "string" },
        "statusPurpose":        { "type": "string" },
        "statusListIndex":      { "type": "string" },
        "statusListCredential": { "type": "string" }
      }
    },
    "validFrom":  { "type": "string" },
    "validUntil": { "type": "string" }
  }
}
