{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEAR Credential Machine V1 — DOME (jwt_vc_json, wrapper vc:{})",

  "credential_configuration_id": "learcredential.machine.w3c.1",
  "credential_format": "jwt_vc_json",
  "scope": "lear_credential_machine",
  "credential_definition": {
    "context": [
      "https://www.w3.org/ns/credentials/v2",
      "https://www.evidenceledger.eu/2022/credentials/machine/v1"
    ],
    "type": ["VerifiableCredential", "LEARCredentialMachine"]
  },
  "cryptographic_binding_methods_supported": ["did:key"],
  "credential_signing_alg_values_supported": ["ES256"],
  "proof_types_supported": {
    "jwt": { "proof_signing_alg_values_supported": ["ES256"] }
  },
  "validity_days": 365,
  "issuer_type": "DETAILED",
  "cnf_required": true,

  "type": "object",
  "required": ["@context", "type", "issuer", "credentialSubject"],
  "additionalProperties": true,
  "vc": {
    "@context": { "type": "array", "items": { "type": "string" } },
    "id": { "type": "string" },
    "type": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "LEARCredentialMachine" }
    },
    "issuer": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" }
      }
    },
    "credentialSubject": {
      "type": "object",
      "required": ["mandate"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "mandate": {
          "type": "object",
          "required": ["mandatee", "mandator", "power"],
          "additionalProperties": true,
          "properties": {
            "id": { "type": "string" },
            "life_span": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "startDateTime":   { "type": "string" },
                "endDateTime":     { "type": "string" },
                "start_date_time": { "type": "string" },
                "end_date_time":   { "type": "string" }
              }
            },
            "mandatee": {
              "type": "object",
              "required": ["id"],
              "additionalProperties": true,
              "properties": {
                "id":          { "type": "string" },
                "serviceName": { "type": "string" },
                "serviceType": { "type": "string" },
                "version":     { "type": "string" },
                "domain":      { "type": "string" },
                "ipAddress":   { "type": "string" },
                "description": { "type": "string" },
                "contact": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "email": { "type": "string" },
                    "phone": { "type": "string" }
                  }
                }
              }
            },
            "mandator": {
              "type": "object",
              "required": ["organizationIdentifier"],
              "additionalProperties": true,
              "properties": {
                "commonName":             { "type": "string" },
                "country":                { "type": "string" },
                "emailAddress":           { "type": "string" },
                "organization":           { "type": "string" },
                "organizationIdentifier": { "type": "string" },
                "serialNumber":           { "type": "string" }
              }
            },
            "power": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "id":           { "type": "string" },
                  "tmf_action":   {},
                  "tmf_domain":   { "type": "string" },
                  "tmf_function": { "type": "string" },
                  "tmf_type":     { "type": "string" }
                }
              }
            },
            "signer": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "commonName":             { "type": "string" },
                "country":                { "type": "string" },
                "emailAddress":           { "type": "string" },
                "organization":           { "type": "string" },
                "organizationIdentifier": { "type": "string" },
                "serialNumber":           { "type": "string" }
              }
            }
          }
        }
      }
    },
    "validFrom":       { "type": "string" },
    "validUntil":      { "type": "string" },
    "expirationDate":  { "type": "string" },
    "issuanceDate":    { "type": "string" }
  }
}
