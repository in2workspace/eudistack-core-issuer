{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEAR Credential Machine V2 — DOME SBX (jwt_vc_json, wrapper vc:{})",

  "credential_configuration_id": "learcredential.machine.w3c.2",
  "credential_format": "jwt_vc_json",
  "scope": "lear_credential_machine",
  "credential_definition": {
    "context": [
      "https://www.w3.org/ns/credentials/v2",
      "https://www.dome-marketplace.eu/2025/credentials/learcredentialmachine/v2"
    ],
    "type": ["VerifiableCredential", "LEARCredentialMachine"]
  },
  "cryptographic_binding_methods_supported": ["did:key"],
  "credential_signing_alg_values_supported": ["ES256"],
  "proof_types_supported": {
    "jwt": { "proof_signing_alg_values_supported": ["ES256"] }
  },
  "validity_days": 365,
  "issuer_type": "DETAILED",
  "cnf_required": true,

  "type": "object",
  "required": ["@context", "type", "issuer", "credentialSubject"],
  "additionalProperties": true,
  "vc": {
    "@context": { "type": "array", "items": { "type": "string" } },
    "id": { "type": "string" },
    "type": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "LEARCredentialMachine" }
    },
    "issuer": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["id"],
          "additionalProperties": true,
          "properties": {
            "id":                     { "type": "string" },
            "organizationIdentifier": { "type": "string" },
            "organization":           { "type": "string" },
            "country":                { "type": "string" },
            "commonName":             { "type": "string" },
            "email":                  { "type": "string" }
          }
        }
      ]
    },
    "credentialSubject": {
      "type": "object",
      "required": ["mandate"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "mandate": {
          "type": "object",
          "required": ["mandatee", "mandator", "power"],
          "additionalProperties": true,
          "properties": {
            "mandatee": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "id":        { "type": "string" },
                "domain":    { "type": "string" },
                "ipAddress": { "type": "string" }
              }
            },
            "mandator": {
              "type": "object",
              "required": ["organizationIdentifier"],
              "additionalProperties": true,
              "properties": {
                "id":                     { "type": "string" },
                "commonName":             { "type": "string" },
                "country":                { "type": "string" },
                "email":                  { "type": "string" },
                "organization":           { "type": "string" },
                "organizationIdentifier": { "type": "string" }
              }
            },
            "power": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "action":   {},
                  "domain":   { "type": "string" },
                  "function": { "type": "string" },
                  "type":     { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "credentialStatus": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id":                   { "type": "string" },
        "type":                 { "type": "string" },
        "statusPurpose":        { "type": "string" },
        "statusListIndex":      { "type": "string" },
        "statusListCredential": { "type": "string" }
      }
    },
    "validFrom":  { "type": "string" },
    "validUntil": { "type": "string" }
  }
}
