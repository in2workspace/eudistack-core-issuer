{
  "credential_configuration_id": "learcredential.machine.w3c.1",
  "description": "DOME — Verifiable Credential for machines (V1, legacy life_span/tmf_* format)",
  "credential_metadata": {
    "display": [
      {
        "name": "LEAR Credential Machine (DOME v1)",
        "locale": "en",
        "description": "Verifiable Credential for machines",
        "background_color": "#34434B",
        "text_color": "#FFFFFF"
      },
      {
        "name": "Credencial LEAR Máquina (DOME v1)",
        "locale": "es",
        "description": "Credencial Verificable para máquinas",
        "background_color": "#34434B",
        "text_color": "#FFFFFF"
      }
    ],
    "claims": [
      { "path": ["credentialSubject", "mandate", "mandatee", "domain"],                 "display": [{ "name": "Domain", "locale": "en" }, { "name": "Dominio", "locale": "es" }] },
      { "path": ["credentialSubject", "mandate", "mandatee", "ipAddress"],              "display": [{ "name": "IP Address", "locale": "en" }, { "name": "Dirección IP", "locale": "es" }] },
      { "path": ["credentialSubject", "mandate", "mandatee", "id"],                     "display": [{ "name": "ID", "locale": "en" }, { "name": "ID", "locale": "es" }] },
      { "path": ["credentialSubject", "mandate", "mandator", "commonName"],             "display": [{ "name": "Common Name", "locale": "en" }, { "name": "Nombre Común", "locale": "es" }] },
      { "path": ["credentialSubject", "mandate", "mandator", "emailAddress"],           "display": [{ "name": "Email", "locale": "en" }, { "name": "Correo Electrónico", "locale": "es" }] },
      { "path": ["credentialSubject", "mandate", "mandator", "organization"],           "display": [{ "name": "Organization", "locale": "en" }, { "name": "Organización", "locale": "es" }] },
      { "path": ["credentialSubject", "mandate", "mandator", "organizationIdentifier"], "display": [{ "name": "Organization ID", "locale": "en" }, { "name": "ID de Organización", "locale": "es" }] },
      { "path": ["credentialSubject", "mandate", "mandator", "country"],                "display": [{ "name": "Country", "locale": "en" }, { "name": "País", "locale": "es" }] },
      { "path": ["credentialSubject", "mandate", "power"],                              "display": [{ "name": "Powers", "locale": "en" }, { "name": "Poderes", "locale": "es" }] }
    ]
  },
  "subject_extraction": {
    "strategy": "field",
    "fields": ["mandatee.domain"],
    "separator": null
  },
  "organization_extraction": {
    "strategy": "field",
    "field": "mandator.organizationIdentifier"
  },
  "policy_extraction": {
    "powers_path": "credentialSubject.mandate.power",
    "mandator_path": "credentialSubject.mandate.mandator",
    "org_id_field": "organizationIdentifier"
  },
  "validation": {
    "schema_required": true,
    "valid_from_path": "validFrom",
    "valid_until_path": "validUntil",
    "issuer_id_path": null,
    "mandator_org_id_path": "credentialSubject.mandate.mandator.organizationIdentifier"
  },
  "grant_eligibility": ["client_credentials", "authorization_code"],
  "token_claims_mapping": {
    "subject_paths": ["credentialSubject.mandate.mandatee.ipAddress", "credentialSubject.mandate.mandatee.domain"],
    "access_token": {
      "tenant": "credentialSubject.mandate.mandator.organizationIdentifier"
    },
    "id_token_embed": {
      "mandatee": "credentialSubject.mandate.mandatee",
      "mandator": "credentialSubject.mandate.mandator",
      "power": "credentialSubject.mandate.power"
    },
    "access_token_embed": {
      "mandatee": "credentialSubject.mandate.mandatee",
      "mandator": "credentialSubject.mandate.mandator",
      "power": "credentialSubject.mandate.power",
      "vc": ""
    },
    "scope": "machine learcredential"
  }
}
