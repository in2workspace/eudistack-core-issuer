{
  "credential_configuration_id": "eu.europa.ec.eudi.pid.1",
  "description": "EU Digital Identity Wallet — Person Identification Data",
  "credential_metadata": {
    "display": [
      {
        "name": "EUDI PID",
        "locale": "en",
        "description": "EU Digital Identity Wallet — Person Identification Data"
      },
      {
        "name": "PID EUDI",
        "locale": "es",
        "description": "Cartera de Identidad Digital Europea — Datos de Identificación Personal"
      }
    ],
    "claims": [
      { "path": ["given_name"],         "display": [{ "name": "Given Name", "locale": "en" }, { "name": "Nombre", "locale": "es" }] },
      { "path": ["family_name"],        "display": [{ "name": "Family Name", "locale": "en" }, { "name": "Apellidos", "locale": "es" }] },
      { "path": ["birth_date"],         "display": [{ "name": "Date of Birth", "locale": "en" }, { "name": "Fecha de Nacimiento", "locale": "es" }] },
      { "path": ["birth_place"],        "display": [{ "name": "Place of Birth", "locale": "en" }, { "name": "Lugar de Nacimiento", "locale": "es" }] },
      { "path": ["nationality"],        "display": [{ "name": "Nationality", "locale": "en" }, { "name": "Nacionalidad", "locale": "es" }] },
      { "path": ["issuance_date"],      "display": [{ "name": "Issuance Date", "locale": "en" }, { "name": "Fecha de Emisión", "locale": "es" }] },
      { "path": ["expiry_date"],        "display": [{ "name": "Expiry Date", "locale": "en" }, { "name": "Fecha de Caducidad", "locale": "es" }] },
      { "path": ["issuing_authority"],  "display": [{ "name": "Issuing Authority", "locale": "en" }, { "name": "Autoridad Emisora", "locale": "es" }] },
      { "path": ["issuing_country"],    "display": [{ "name": "Issuing Country", "locale": "en" }, { "name": "País Emisor", "locale": "es" }] },
      { "path": ["document_number"],    "display": [{ "name": "Document Number", "locale": "en" }, { "name": "Número de Documento", "locale": "es" }] }
    ],
    "summary_claims": [
      ["given_name"],
      ["family_name"],
      ["birth_date"]
    ]
  },
  "subject_extraction": {
    "strategy": "concat",
    "fields": ["given_name", "family_name"],
    "separator": " "
  },
  "validation": {
    "schema_required": true,
    "valid_from_path": "nbf",
    "valid_until_path": "exp",
    "issuer_id_path": "iss",
    "mandator_org_id_path": null,
    "revocation": {
      "type": "TokenStatusList",
      "status_path": "status"
    }
  },
  "grant_eligibility": ["authorization_code", "urn:ietf:params:oauth:grant-type:pre-authorized_code"],
  "token_claims_mapping": {
    "subject_paths": ["document_number", "given_name"],
    "id_token": {
      "given_name": "given_name",
      "family_name": "family_name",
      "birthdate": "birth_date",
      "name": {
        "strategy": "concat",
        "paths": ["given_name", "family_name"],
        "separator": " "
      }
    },
    "access_token": {},
    "id_token_embed": {
      "given_name": "given_name",
      "family_name": "family_name",
      "birth_date": "birth_date",
      "birth_place": "birth_place",
      "nationality": "nationality",
      "issuing_authority": "issuing_authority",
      "issuing_country": "issuing_country"
    },
    "access_token_embed": {},
    "scope": "openid eu_europa_ec_eudi_pid_1"
  }
}
