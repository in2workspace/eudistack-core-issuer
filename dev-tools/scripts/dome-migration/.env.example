# ─── Base de datos destino (EUDIStack / AWS RDS) ──────────────────────────────
DB_HOST=localhost                     # PRD: <rds-endpoint>.rds.amazonaws.com
DB_PORT=5432
DB_NAME=eudi_db                       # nombre real de la base de datos destino
DB_USER=dome_user
DB_PASSWORD=changeme

# Docker local: disable | AWS RDS STG/PRD: require
DB_SSLMODE=disable

# ─── Rutas ────────────────────────────────────────────────────────────────────
# Ruta al CSV exportado de IONOS (ver sección 4.1 del runbook)
CSV_INPUT_PATH=./credential_procedure_YYYYMMDD.csv

# Directorio donde se guardan los informes de reconciliación (se crea automáticamente)
REPORT_OUTPUT_DIR=./reports/
